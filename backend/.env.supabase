# =====================================================================
# SUPABASE BACKEND MASTER CREDENTIALS GUIDE
# =====================================================================
# Follow these steps to obtain every detail from your Supabase Dashboard:
#
# STEP 1: Create a Project
# - Go to https://supabase.com/dashboard/projects
# - Click "New Project", choose an organization, name it "visioninsight",
#   and set a strong database password (keep this password handy!).
#
# STEP 2: Get API URL and Keys
# - Go to Project Settings (gear icon) -> "API":
#   1. Project URL         --> SUPABASE_SERVICE_URL & SUPABASE_URL
#   2. Project API Keys:
#      - anon public       --> SUPABASE_ANON_KEY
#      - service_role      --> SUPABASE_SERVICE_ROLE_KEY
#
# STEP 3: Get Database Connection URL
# - Go to Project Settings -> "Database":
#   - Scroll to "Connection String" -> Select "URI"
#   - Choose "Transaction Pooler (Port 6543)" or "Session Pooler (Port 5432)"
#   - Replace [YOUR-PASSWORD] with the database password set in Step 1.
#   - Copy to DATABASE_URL.
#
# STEP 4: Run Database Schema
# - Go to "SQL Editor" -> Click "New Query"
# - Paste the contents of backend/supabase_schema.sql and click "Run".
# =====================================================================

SUPABASE_SERVICE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here
DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

